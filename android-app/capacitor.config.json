{
  "appId": "com.eladnavon.watchlist",
  "appName": "My Watch List",
  "webDir": "android-shell",
  "server": {
    "url": "https://elad-navon.github.io/my-watch-list/",
    "errorPath": "index.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_wl",
      "iconColor": "#FBBF24"
    }
  }
}
