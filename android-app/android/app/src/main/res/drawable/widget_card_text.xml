<?xml version="1.0" encoding="utf-8"?>
<!-- A one-row card: the card's fill with a thin yellow line down its left edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0CFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:gravity="left|fill_vertical" android:width="2dp" android:top="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#8CFBBF24" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
