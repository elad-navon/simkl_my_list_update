{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",

    "types": ["node"]
  },
  // A composite project has to list every file it pulls in, and the scripts
  // import the domain, library and api modules directly - so those are listed
  // alongside `scripts`. Deliberately NOT all of `src`: the React entry points
  // need the DOM lib and JSX, which a Node script has no business seeing.
  // tsconfig.app.json still checks every one of these files on its own without
  // Node's globals, so browser code cannot quietly start using `process`.
  "include": ["scripts", "src/api", "src/domain", "src/library"],
  "exclude": ["**/*.test.ts"]
}
