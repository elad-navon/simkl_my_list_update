{
  "name": "tvseries-my-list",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Personal TV watch-list dashboard. Your list lives locally; TMDB/TVmaze/OMDb supply public metadata.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "parity": "vite-node scripts/parity.ts",
    "migrate": "vite-node scripts/migrate.ts",
    "coverage": "vite-node scripts/coverage.ts",
    "profile": "vite-node scripts/profile-load.ts"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.62.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-persist-client": "^5.62.0",
    "idb-keyval": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vite-node": "^3.2.4",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7"
  }
}
