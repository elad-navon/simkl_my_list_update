# Regenerable, never versioned.
node_modules/
dist/

# Personal data. The SIMKL export and the library files derived from it hold the
# whole watch history, and this repo is public, so they are ignored by name pattern
# rather than by folder: they get moved around and regenerated.
/simkl-export-*.json
/library-*.json
/coverage-*.json
/parity-*.json
/tvmaze-coverage-*.json

# Downloads from tools/migrate.html, tools/import.html and Settings (backups,
# reports) - the same personal data.
/simkl-backup*.json
/import-report-*.json
/migration-report-*.json
/tv-library-*.json

# Emby bridge: secrets, log and installed packages stay on this computer
/tools/emby-bridge/config.json
/tools/emby-bridge/service-account*.json
/tools/emby-bridge/*.log
/tools/emby-bridge/*.log.old
/tools/emby-bridge/node_modules/
/tools/emby-bridge/package-lock.json
/tools/emby-bridge/*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
